            <div class="flex items-center justify-between h-16">
                <!-- Brand Logo & Dynamic Header Title -->
                <div class="flex items-center space-x-3 cursor-pointer" onclick="showRoleSelection()">
                    <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-emerald-500 to-teal-400 flex items-center justify-center text-white shadow-lg font-bold text-xl border border-emerald-300/40">
                        <i class="fa-solid fa-kaaba"></i>
                    </div>
                    <div>
                        <h1 class="font-bold text-base sm:text-lg leading-tight tracking-wide flex items-center gap-1.5 flex-wrap">
                            <span id="headerBrandName">SIPONDOK</span> 
                            <span id="headerPesantrenBadge" class="bg-emerald-600/50 text-emerald-200 text-xs px-2 py-0.5 rounded-md font-extrabold border border-emerald-400/30">PP Miftahul Ulum Kalisat</span>
                            <span class="bg-emerald-500/30 text-emerald-300 text-[10px] px-2 py-0.5 rounded-full border border-emerald-400/30 font-semibold"><i class="fa-solid fa-wand-magic-sparkles mr-1"></i>Gemini AI</span>
                        </h1>
                        <p id="headerTaglineText" class="text-[11px] text-emerald-200/80">Sistem Manajemen & Pembinaan Santri Terpadu</p>
                    </div>
                </div>

                <!-- Controls & Active User Status -->
                <div class="flex items-center space-x-2 sm:space-x-3">
                    <!-- Google AI Studio Status Indicator -->
                    <button onclick="openApiKeyModal()" class="bg-slate-800/80 hover:bg-slate-700/80 text-emerald-300 border border-emerald-500/30 px-2.5 py-1.5 rounded-lg text-xs font-semibold flex items-center space-x-1.5 transition" title="Pengaturan API Key Google AI Studio">
                        <i class="fa-solid fa-microchip text-emerald-400"></i>
                        <span class="hidden sm:inline">Google AI Studio</span>
                    </button>

                    <div id="userBadge" class="hidden sm:flex items-center space-x-2 bg-pondok-700/60 px-3 py-1.5 rounded-full border border-pondok-600/50 text-xs">
                        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                        <span id="activeRoleText" class="font-medium text-emerald-100">Belum Login</span>
                    </div>

                    <button id="logoutBtn" onclick="logout()" class="hidden bg-rose-600 hover:bg-rose-700 text-white px-3 py-1.5 rounded-lg text-xs font-semibold shadow transition flex items-center space-x-1">
                        <i class="fa-solid fa-right-from-bracket"></i>
                        <span>Keluar</span>
                    </button>
                    
                    <button onclick="showRoleSelection()" class="bg-emerald-600 hover:bg-emerald-500 text-white px-3 py-1.5 rounded-lg text-xs font-semibold shadow transition flex items-center space-x-1">
                        <i class="fa-solid fa-arrows-rotate"></i>
                        <span class="hidden md:inline">Ganti Peran</span>
                    </button>
                </div>
            </div>
        </div>
    </header>

    <!-- CONTAINER UTAMA APP -->
    <main class="flex-grow max-w-7xl w-full mx-auto p-4 sm:p-6 lg:p-8">

        <!-- 1. LANDING & PORTAL SELECTION VIEW (DYNAMIC VIA ADMIN CMS) -->
        <div id="portalSelectionView" class="space-y-6">
            
            <!-- Hero Banner Intro (Editable via CMS) -->
            <div id="landingHeroCard" class="bg-gradient-to-br from-pondok-900 via-pondok-800 to-slate-900 text-white rounded-2xl p-6 sm:p-10 shadow-2xl relative overflow-hidden border border-pondok-700/40">
                <div class="relative z-10 max-w-3xl space-y-4">
                    <span id="landingHeroBadge" class="inline-flex items-center space-x-1.5 bg-emerald-500/20 text-emerald-300 px-3 py-1 rounded-full text-xs font-semibold tracking-wider uppercase border border-emerald-400/30">
                        <i class="fa-solid fa-building-columns"></i>
                        <span id="landingPesantrenTitle">Pondok Pesantren Miftahul Ulum Kalisat</span>
                    </span>
                    <h2 id="landingHeroTitle" class="text-2xl sm:text-4xl font-extrabold leading-tight tracking-tight">Sistem Informasi Pesantren & Pembinaan Santri Terpadu</h2>
                    <p id="landingHeroDesc" class="text-emerald-100/90 text-sm sm:text-base leading-relaxed">
                        Platform resmi pengelolaan data santri (12 Kelas Awaliyah & Wustho Putra/Putri), absensi harian, kedisiplinan, laporan PDF resmi ber-KOP Surat, serta layanan obrolan Wali Santri & konseling Gemini AI.
                    </p>
                </div>
                <div class="absolute -right-10 -bottom-10 opacity-10 text-white pointer-events-none">
                    <i id="landingHeroIcon" class="fa-solid fa-mosque text-[240px]"></i>
                </div>
            </div>

            <!-- Dynamic Running Alert / Pengumuman Banner -->
            <div class="bg-amber-500 text-slate-900 px-4 py-2 rounded-xl shadow-sm border border-amber-400 flex items-center space-x-3 text-xs font-bold">
                <span class="bg-slate-900 text-amber-400 px-2.5 py-0.5 rounded-md text-[10px] uppercase font-black tracking-wider shrink-0">
                    <i class="fa-solid fa-bullhorn mr-1"></i> Pengumuman
                </span>
                <div class="marquee-container flex-grow">
                    <div id="landingRunningBanner" class="marquee-content font-semibold">
                        📢 PENGUMUMAN: Pendaftaran Santri Baru Tahun Ajaran 2026/2027 PP Miftahul Ulum Kalisat Telah Dibuka! | Libur Akhir Semester Dimulai Tanggal 15 Desember.
                    </div>
                </div>
            </div>

            <!-- Dynamic Visi & Misi Section (Positioned Directly Below Pengumuman Banner) -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 my-2">
                <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-2">
                    <h3 class="font-bold text-slate-800 text-sm flex items-center gap-2">
                        <i class="fa-solid fa-eye text-emerald-600"></i> Visi Pesantren
                    </h3>
                    <p id="landingVisiText" class="text-xs text-slate-600 leading-relaxed italic bg-emerald-50/50 p-3.5 rounded-xl border border-emerald-100">
                        "Terwujudnya Generasi Santri Berakhlakul Karimah, Unggul Dalam Ilmu Agama, Tafaqquh Fiddin, dan Berwawasan Tekno-Sains."
                    </p>
                </div>
                <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-2">
                    <h3 class="font-bold text-slate-800 text-sm flex items-center gap-2">
                        <i class="fa-solid fa-bullseye text-blue-600"></i> Misi Pesantren
                    </h3>
                    <div id="landingMisiText" class="text-xs text-slate-600 leading-relaxed bg-blue-50/50 p-3.5 rounded-xl border border-blue-100 whitespace-pre-line">
                        1. Menyelenggarakan pendidikan madrasah diniyah berkualitas (Awaliyah & Wustho).
                        2. Membina hafalan Al-Qur'an dan penguasaan Kitab Kuning secara terstruktur.
                        3. Membangun komunikasi transparan antara Pengurus, Ustadz, dan Wali Santri.
                    </div>
                </div>
            </div>

            <!-- Role Selection Options Grid -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                
                <!-- Card 1: Admin Pondok -->
                <div class="bg-white rounded-2xl p-6 shadow-md border border-slate-200/80 hover:shadow-xl transition-all duration-300 flex flex-col justify-between group">
                    <div>
                        <div class="w-14 h-14 rounded-2xl bg-emerald-100 text-pondok-700 flex items-center justify-center text-2xl mb-4 group-hover:scale-110 transition-transform">
                            <i class="fa-solid fa-user-shield"></i>
                        </div>
                        <h3 class="text-xl font-bold text-slate-800">1. Admin Pondok</h3>
                        <p class="text-slate-500 text-xs mt-1 mb-4">Pengelola Utama, CMS Tampilan & PDF AI</p>
                        <ul class="text-xs text-slate-600 space-y-2 mb-6">
                            <li class="flex items-start"><i class="fa-solid fa-check text-emerald-500 mr-2 mt-0.5"></i> Edit Tampilan Depan / CMS Landing Page</li>
                            <li class="flex items-start"><i class="fa-solid fa-check text-emerald-500 mr-2 mt-0.5"></i> Kelola Santri (12 Kelas Awaliyah & Wustho)</li>
                            <li class="flex items-start"><i class="fa-solid fa-check text-emerald-500 mr-2 mt-0.5"></i> Kelola Akun Guru & Password Wali Santri</li>
                            <li class="flex items-start"><i class="fa-solid fa-check text-emerald-500 mr-2 mt-0.5 font-bold"></i> Pusat Pesan & Chat Seluruh Wali Santri</li>
                            <li class="flex items-start"><i class="fa-solid fa-check text-emerald-500 mr-2 mt-0.5"></i> Cetak PDF Resmi & Narasi Evaluasi AI</li>
                        </ul>
                    </div>
                    <button onclick="openLoginModal('admin')" class="w-full bg-pondok-700 hover:bg-pondok-800 text-white font-semibold py-3 px-4 rounded-xl text-sm transition shadow-md flex items-center justify-center space-x-2">
                        <span>Login Admin</span>
                        <i class="fa-solid fa-arrow-right"></i>
                    </button>
                </div>

                <!-- Card 2: Guru / Ustadz -->
                <div class="bg-white rounded-2xl p-6 shadow-md border border-slate-200/80 hover:shadow-xl transition-all duration-300 flex flex-col justify-between group">
                    <div>
                        <div class="w-14 h-14 rounded-2xl bg-blue-100 text-blue-700 flex items-center justify-center text-2xl mb-4 group-hover:scale-110 transition-transform">
                            <i class="fa-solid fa-chalkboard-user"></i>
                        </div>
                        <h3 class="text-xl font-bold text-slate-800">2. Portal Guru</h3>
                        <p class="text-slate-500 text-xs mt-1 mb-4">Pengajar & Pembina Kedisiplinan</p>
                        <ul class="text-xs text-slate-600 space-y-2 mb-6">
                            <li class="flex items-start"><i class="fa-solid fa-check text-blue-500 mr-2 mt-0.5"></i> Presensi Harian 12 Kelas (H, S, I, A)</li>
                            <li class="flex items-start"><i class="fa-solid fa-check text-blue-500 mr-2 mt-0.5"></i> Input Pelanggaran & AI Sanksi Mendidik</li>
                            <li class="flex items-start"><i class="fa-solid fa-check text-blue-500 mr-2 mt-0.5 font-bold"></i> Fitur Chat Direct dengan Wali Santri</li>
                            <li class="flex items-start"><i class="fa-solid fa-check text-blue-500 mr-2 mt-0.5 font-bold"></i> Draf Balasan Chat Otomatis via AI</li>
                        </ul>
                    </div>
                    <button onclick="openLoginModal('guru')" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-4 rounded-xl text-sm transition shadow-md flex items-center justify-center space-x-2">
                        <span>Login Guru</span>
                        <i class="fa-solid fa-arrow-right"></i>
                    </button>
                </div>

                <!-- Card 3: Wali Santri -->
                <div class="bg-white rounded-2xl p-6 shadow-md border border-slate-200/80 hover:shadow-xl transition-all duration-300 flex flex-col justify-between group">
                    <div>
                        <div class="w-14 h-14 rounded-2xl bg-purple-100 text-purple-700 flex items-center justify-center text-2xl mb-4 group-hover:scale-110 transition-transform">
                            <i class="fa-solid fa-users-between-lines"></i>
                        </div>
                        <h3 class="text-xl font-bold text-slate-800">3. Wali Santri</h3>
                        <p class="text-slate-500 text-xs mt-1 mb-4">Orang Tua / Wali Murid</p>
                        <ul class="text-xs text-slate-600 space-y-2 mb-6">
                            <li class="flex items-start"><i class="fa-solid fa-check text-purple-500 mr-2 mt-0.5"></i> Pantau Presensi Santri (H, S, I, A)</li>
                            <li class="flex items-start"><i class="fa-solid fa-check text-purple-500 mr-2 mt-0.5"></i> Lihat Record Pelanggaran & Sanksi</li>
                            <li class="flex items-start"><i class="fa-solid fa-check text-purple-500 mr-2 mt-0.5 font-bold"></i> Chat Direct ke Admin / Ustadz Pengampu</li>
                            <li class="flex items-start"><i class="fa-solid fa-check text-purple-500 mr-2 mt-0.5 font-bold"></i> AI Konsultasi Parenting Islami</li>
                        </ul>
                    </div>
                    <button onclick="openLoginModal('wali')" class="w-full bg-purple-600 hover:bg-purple-700 text-white font-semibold py-3 px-4 rounded-xl text-sm transition shadow-md flex items-center justify-center space-x-2">
                        <span>Login Wali Santri</span>
                        <i class="fa-solid fa-arrow-right"></i>
                    </button>
                </div>

            </div>

        </div>

        <!-- 2. APPLICATION DASHBOARDS CONTAINER -->
        <div id="appContainer" class="hidden space-y-6">
            
            <!-- ADMIN PONDOK APPLICATION VIEW -->
            <div id="adminView" class="hidden space-y-6">
                <!-- Navigation Tabs Admin (INCLUDES NEW CMS TAB) -->
                <div class="bg-white p-2 rounded-2xl shadow-sm border border-slate-200 flex flex-wrap gap-1.5 text-xs sm:text-sm">
                    <button onclick="switchAdminTab('santri')" id="adminTab-santri" class="admin-tab-btn flex-1 min-w-[110px] py-2.5 px-3 rounded-xl font-semibold transition flex items-center justify-center space-x-1.5 bg-pondok-700 text-white">
                        <i class="fa-solid fa-graduation-cap"></i>
                        <span>Data Santri</span>
                    </button>
                    <button onclick="switchAdminTab('cms')" id="adminTab-cms" class="admin-tab-btn flex-1 min-w-[130px] py-2.5 px-3 rounded-xl font-semibold transition flex items-center justify-center space-x-1.5 hover:bg-slate-100 text-slate-600 bg-amber-50 text-amber-800 font-bold border border-amber-200/80">
                        <i class="fa-solid fa-sliders text-amber-600"></i>
                        <span>Edit Tampilan Awal (CMS)</span>
                    </button>
                    <button onclick="switchAdminTab('guru')" id="adminTab-guru" class="admin-tab-btn flex-1 min-w-[110px] py-2.5 px-3 rounded-xl font-semibold transition flex items-center justify-center space-x-1.5 hover:bg-slate-100 text-slate-600">
                        <i class="fa-solid fa-chalkboard-user"></i>
                        <span>Akun Guru</span>
                    </button>
                    <button onclick="switchAdminTab('wali')" id="adminTab-wali" class="admin-tab-btn flex-1 min-w-[110px] py-2.5 px-3 rounded-xl font-semibold transition flex items-center justify-center space-x-1.5 hover:bg-slate-100 text-slate-600">
                        <i class="fa-solid fa-users"></i>
                        <span>Akun Wali Santri</span>
                    </button>
                    <button onclick="switchAdminTab('pelanggaran')" id="adminTab-pelanggaran" class="admin-tab-btn flex-1 min-w-[110px] py-2.5 px-3 rounded-xl font-semibold transition flex items-center justify-center space-x-1.5 hover:bg-slate-100 text-slate-600">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                        <span>Pelanggaran</span>
                    </button>
                    <button onclick="switchAdminTab('rekap')" id="adminTab-rekap" class="admin-tab-btn flex-1 min-w-[110px] py-2.5 px-3 rounded-xl font-semibold transition flex items-center justify-center space-x-1.5 hover:bg-slate-100 text-slate-600">
                        <i class="fa-solid fa-clipboard-check"></i>
                        <span>Rekap Absen</span>
                    </button>
                    <button onclick="switchAdminTab('chat')" id="adminTab-chat" class="admin-tab-btn flex-1 min-w-[120px] py-2.5 px-3 rounded-xl font-semibold transition flex items-center justify-center space-x-1.5 hover:bg-slate-100 text-slate-600 relative">
                        <i class="fa-solid fa-comments"></i>
                        <span>Pesan Wali</span>
                        <span id="adminUnreadBadge" class="hidden bg-rose-500 text-white text-[10px] font-bold px-1.5 py-0.2 rounded-full">0</span>
                    </button>
                    <button onclick="switchAdminTab('laporan')" id="adminTab-laporan" class="admin-tab-btn flex-1 min-w-[120px] py-2.5 px-3 rounded-xl font-semibold transition flex items-center justify-center space-x-1.5 hover:bg-slate-100 text-slate-600">
                        <i class="fa-solid fa-file-pdf"></i>
                        <span>Cetak PDF + AI</span>
                    </button>
                </div>

                <!-- NEW ADMIN SECTION: EDIT TAMPILAN AWAL (CMS HALAMAN DEPAN) -->
                <div id="adminContent-cms" class="admin-content-sec hidden space-y-4">
                    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-5">
                        <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                            <div>
                                <h3 class="text-lg font-bold text-slate-800 flex items-center space-x-2">
                                    <i class="fa-solid fa-sliders text-amber-500"></i>
                                    <span>Pengaturan CMS Tampilan Halaman Depan</span>
                                </h3>
                                <p class="text-xs text-slate-500">Ubah seluruh teks, pengumuman running banner, visi-misi, dan kontak yang muncul di halaman awal publik.</p>
                            </div>
                            <button onclick="resetLandingCMSToDefault()" class="bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold px-3 py-2 rounded-xl transition flex items-center space-x-1">
                                <i class="fa-solid fa-rotate-left"></i>
                                <span>Reset Bawaan Pesantren</span>
                            </button>
                        </div>

                        <form onsubmit="handleSaveCMS(event)" class="space-y-4 text-xs">
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div>
                                    <label class="block font-semibold text-slate-700 mb-1">Nama Pesantren:</label>
                                    <input type="text" id="cmsNamaPesantren" required class="w-full bg-slate-50 border border-slate-300 rounded-xl p-3 text-slate-800 focus:outline-none focus:ring-2 focus:ring-amber-500">
                                </div>
                                <div>
                                    <label class="block font-semibold text-slate-700 mb-1">Tagline / Subtitle Header:</label>
                                    <input type="text" id="cmsTagline" required class="w-full bg-slate-50 border border-slate-300 rounded-xl p-3 text-slate-800 focus:outline-none focus:ring-2 focus:ring-amber-500">
                                </div>
                            </div>

                            <div>
                                <label class="block font-semibold text-slate-700 mb-1">Teks Running Alert Banner (Pengumuman Berjalan):</label>
                                <input type="text" id="cmsRunningBanner" required class="w-full bg-slate-50 border border-slate-300 rounded-xl p-3 text-slate-800 focus:outline-none focus:ring-2 focus:ring-amber-500 font-semibold">
                            </div>

                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div>
                                    <label class="block font-semibold text-slate-700 mb-1">Judul Hero Banner Depan:</label>
                                    <input type="text" id="cmsHeroTitle" required class="w-full bg-slate-50 border border-slate-300 rounded-xl p-3 text-slate-800 focus:outline-none focus:ring-2 focus:ring-amber-500">
                                </div>
                                <div>
                                    <label class="block font-semibold text-slate-700 mb-1">Class Ikon Hero FontAwesome:</label>
                                    <input type="text" id="cmsHeroIconClass" required placeholder="fa-solid fa-mosque" class="w-full bg-slate-50 border border-slate-300 rounded-xl p-3 text-slate-800 focus:outline-none focus:ring-2 focus:ring-amber-500 font-mono">
                                </div>
                            </div>

                            <div>
                                <label class="block font-semibold text-slate-700 mb-1">Deskripsi Sambutan Utama (Hero Description):</label>
                                <textarea id="cmsHeroDesc" rows="3" required class="w-full bg-slate-50 border border-slate-300 rounded-xl p-3 text-slate-800 focus:outline-none focus:ring-2 focus:ring-amber-500"></textarea>
                            </div>

                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div>
                                    <label class="block font-semibold text-slate-700 mb-1">Visi Pesantren:</label>
                                    <textarea id="cmsVisi" rows="3" required class="w-full bg-slate-50 border border-slate-300 rounded-xl p-3 text-slate-800 focus:outline-none focus:ring-2 focus:ring-amber-500"></textarea>
                                </div>
                                <div>
                                    <label class="block font-semibold text-slate-700 mb-1">Misi Pesantren:</label>
                                    <textarea id="cmsMisi" rows="3" required class="w-full bg-slate-50 border border-slate-300 rounded-xl p-3 text-slate-800 focus:outline-none focus:ring-2 focus:ring-amber-500"></textarea>
                                </div>
                            </div>

                            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                                <div>
                                    <label class="block font-semibold text-slate-700 mb-1">Alamat Lengkap Pesantren:</label>
                                    <input type="text" id="cmsAlamat" required class="w-full bg-slate-50 border border-slate-300 rounded-xl p-3 text-slate-800 focus:outline-none focus:ring-2 focus:ring-amber-500">
                                </div>
                                <div>
                                    <label class="block font-semibold text-slate-700 mb-1">Nomor Telepon / WA:</label>
                                    <input type="text" id="cmsTelpWA" required class="w-full bg-slate-50 border border-slate-300 rounded-xl p-3 text-slate-800 focus:outline-none focus:ring-2 focus:ring-amber-500">
                                </div>
                                <div>
                                    <label class="block font-semibold text-slate-700 mb-1">Email Resmi Pesantren:</label>
                                    <input type="email" id="cmsEmail" required class="w-full bg-slate-50 border border-slate-300 rounded-xl p-3 text-slate-800 focus:outline-none focus:ring-2 focus:ring-amber-500">
